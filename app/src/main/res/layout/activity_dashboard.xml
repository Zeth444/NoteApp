<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cyber_gradient"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/spacing_large">

    <TextView
        android:id="@+id/tv_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/neon_cyan"
        android:textSize="28sp"
        android:textStyle="bold"
        android:shadowColor="@color/neon_pink"
        android:shadowRadius="15"
        android:shadowDx="0"
        android:shadowDy="0"
        android:layout_marginBottom="@dimen/spacing_xlarge"
        tools:text="¡Hola!" /> <!-- Aquí está la magia: tools:text -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_btn_create"
        android:backgroundTint="@color/neon_pink"
        android:layout_marginBottom="@dimen/spacing_medium"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_list_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_btn_list"
        android:backgroundTint="@color/neon_cyan"
        android:textColor="#000000"
        android:layout_marginBottom="@dimen/spacing_xlarge"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_logout"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_btn_logout"
        android:textColor="@color/neon_pink"/>

</LinearLayout>